{
  "name": "chansight",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "ChanSight (チャンサイト) - Multi-tenant YouTube Analytics Remote MCP Server on Cloudflare Workers",
  "homepage": "https://chansight.nseto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nseto-swdev/chansight.git"
  },
  "bugs": {
    "url": "https://github.com/nseto-swdev/chansight/issues"
  },
  "scripts": {
    "build:version": "node scripts/write-build-info.mjs",
    "predev": "node scripts/write-build-info.mjs",
    "dev": "wrangler dev --host localhost:8787 --port 8787",
    "predeploy": "node scripts/write-build-info.mjs",
    "deploy": "wrangler deploy",
    "pretypecheck": "node scripts/write-build-info.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/write-build-info.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.0.0"
  }
}
